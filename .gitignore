# Bí mật — TUYỆT ĐỐI không commit, không gửi cho ai
.env

# Rác Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
venv/

# Toàn bộ dữ liệu sống dưới data/ kể từ 03/09/2026.
#   data/raw/     — tải từ API/nguồn gốc, tái tạo bằng scripts/fetch_*.py
#   data/interim/ — bảng trung gian, dựng bằng build_*.py + merge_panel.py
#   data/final/   — dataframe Stage 1, dựng bằng build_stage1_df.py
# Không đưa vào git; gửi cộng sự qua Drive/USB. Từ điển biến thì TRACK.
# `data/*` (không phải `data/`) là bắt buộc: một pattern trơ "dir/" loại trừ
# cả thư mục như một khối kín, git sẽ không descend vào để áp các dòng "!"
# phía sau (xem "It is not possible to re-include a file if a parent
# directory of that file is excluded" trong gitignore(5)). "dir/*" chỉ loại
# từng file con nên các dòng "!" bên dưới vẫn có hiệu lực.
data/*
!data/final/
data/final/*
!data/final/README.md

# Kết quả mô hình (KM, hazard, sensitivity) — dựng lại bằng survival_baseline.py
legacy/analysis/

# Log của các luồng tải — chỉ có ý nghĩa trên máy đang chạy
logs/

# Output kiểm chứng API, tái tạo bằng scripts/wits_probe.py.
# Giữ lại đúng nhật ký 22 phép thử vì tài liệu KIEM_CHUNG có trích dẫn.
probe_out/*
!probe_out/_probe_log.csv

# Gói bàn giao cho cộng sự — dựng lại được bằng lệnh tar trong README §8.
# Chỉ chặn ở thư mục gốc: bản hash của gói đã gửi nằm trong docs/ và được TRACK.
/wits_data_*.tar.gz
/wits_data_*.tar.gz.sha256
# Thư mục gói đã gom sẵn (851 MB) — dựng lại được từ chính lệnh đó
/wits_data_2*/

# Slide: code và template gốc thì TRACK (legacy/deck/src, legacy/deck/assets); phần dưới đây
# đều dựng lại được bằng legacy/deck/src/make_figs.py, figs2.py, figs4.py,
# build_deck.py, build2.py, build4.py
legacy/deck/fig/
legacy/deck/fig2/
legacy/deck/fig4/
legacy/deck/preview/
legacy/deck/out/

# Rác hệ điều hành / trình soạn thảo
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Benchmark (legacy): code, frozen config và bảng kết quả thì TRACK. Phần dưới đây đều
# dựng lại được bằng legacy/benchmark/run_benchmark.py và quá nặng để đưa vào git.
legacy/benchmark/runs/*/predictions/
legacy/benchmark/runs/*/cells/
legacy/benchmark/runs/*/metrics.parquet
# checkpoint tạm của pycox EarlyStopping (đã đổi hướng ra thư mục tạm, dòng này
# chỉ để chặn nếu ai đó chạy với biến môi trường mặc định)
weight_checkpoint_*.pt
pycox_ckpt_*.pt
logs/benchmark/
